<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark from the first frame, whatever the phone's own theme: Noctorium Stats only has the Night theme, and a
  light window behind it would show for a moment on every launch.
-->
<resources>
    <!-- From the moment the process starts until Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind Flutter for as long as it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
